# ---------------------------------------------------------------------------
# KG Gold Garden - caretaker credentials
#
# HOW TO USE:
#   1. Make a copy of this file in this same folder named exactly:  secrets.env
#   2. Fill in the two values below with your admin login.
#   3. Save. Never share, email, or upload secrets.env.
#
# These are ONLY needed if you turn on autoRestoreRates in config.json.
# Without them the agent still pings the site and reports - it just cannot
# put your rates back by itself.
#
# secrets.env is gitignored, so it will never be committed or deployed.
# ---------------------------------------------------------------------------

ADMIN_USERNAME=
ADMIN_PASSWORD=
