# ---------------------------------------------------------------------------
# KG Gold Garden — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port 3000 is often already taken by another dev server, so this project
# defaults to 4400. Change it freely.
PORT=4400

# --- Email (Gmail) ---------------------------------------------------------
# The site sends from primeplay345@gmail.com. Gmail will NOT accept your normal
# account password here — you must create a 16-character "App Password":
#
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
#      (choose "Mail" → "Other" → name it "KG Gold Garden website")
#   3. Paste the 16 characters below, spaces removed.
#
# Until this is set, the site still works: signups and appointments are saved to
# disk under data/ and queued in data/outbox/, and the website honestly tells the
# visitor that delivery is pending rather than pretending the mail was sent.
SMTP_USER=primeplay345@gmail.com
SMTP_PASS=

# --- Admin ------------------------------------------------------------------
# Token required to update the daily gold rate via POST /api/rates.
# If left blank, a random token is generated and printed to the console at startup.
ADMIN_TOKEN=

# --- Public address ---------------------------------------------------------
# Used in the daily reminder so the "enter the rate" link works from a phone.
# Set this to the real domain once the site is deployed.
PUBLIC_URL=http://localhost:4400

# --- Daily WhatsApp reminder (optional) -------------------------------------
# At 12:00 PM India time the server asks both owners for the day's rate.
#
# It ALWAYS emails primeplay345@gmail.com with a tap-to-send WhatsApp link for
# each owner — that works with no setup beyond SMTP_PASS above.
#
# To have the server message them directly instead, add WhatsApp Business Cloud
# API credentials. Note that Meta only allows free-form text inside a 24-hour
# window the customer opened; a business-initiated daily message needs a
# pre-approved template, so set WHATSAPP_TEMPLATE to its approved name.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# --- AI chatbot (optional) --------------------------------------------------
# Without a key the chatbot runs on a built-in intent engine that answers the
# common questions and hands off to WhatsApp. With a key it additionally uses
# Claude for free-form questions. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
