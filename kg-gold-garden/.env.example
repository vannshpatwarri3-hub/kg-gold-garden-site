# ---------------------------------------------------------------------------
# KG Gold Garden — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

PORT=3000

# --- Email (Gmail) ---------------------------------------------------------
# The site sends from primeplay345@gmail.com. Gmail will NOT accept your normal
# account password here — you must create a 16-character "App Password":
#
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:       https://myaccount.google.com/apppasswords
#      (choose "Mail" → "Other" → name it "KG Gold Garden website")
#   3. Paste the 16 characters below, spaces removed.
#
# Until this is set, the site still works: signups and appointments are saved to
# disk under data/ and queued in data/outbox/, and the website honestly tells the
# visitor that delivery is pending rather than pretending the mail was sent.
SMTP_USER=primeplay345@gmail.com
SMTP_PASS=

# --- Admin ------------------------------------------------------------------
# Token required to update the daily gold rate via POST /api/rates.
# If left blank, a random token is generated and printed to the console at startup.
ADMIN_TOKEN=

# --- AI chatbot (optional) --------------------------------------------------
# Without a key the chatbot runs on a built-in intent engine that answers the
# common questions and hands off to WhatsApp. With a key it additionally uses
# Claude for free-form questions. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
