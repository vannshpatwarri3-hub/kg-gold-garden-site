# ---------------------------------------------------------------------------
# KG Gold Garden — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Port 3000 is often already taken by another dev server, so this project
# defaults to 4400. Change it freely.
PORT=4400

# --- Email (EmailJS, sending from kggoldgarden81@yahoo.com) -----------------
# Render's free tier blocks outbound SMTP, so the site cannot talk to a mail
# server itself. It sends through EmailJS over HTTPS instead, and EmailJS relays
# each message through the shop's connected Yahoo account. All four come from
# https://dashboard.emailjs.com — see server/mailer.js for the template fields.
#
#   EMAILJS_SERVICE_ID   Email Services → the Yahoo service → "Service ID"
#   EMAILJS_TEMPLATE_ID  Email Templates → the KG template → "Template ID"
#   EMAILJS_PUBLIC_KEY   Account → General → "Public Key"
#   EMAILJS_PRIVATE_KEY  Account → General → "Private Key"   (keep it secret)
#
# On Account → Security, BOTH of these must be switched on, or nothing sends:
#   - allow API requests from non-browser applications (this is a server)
#   - require the Private Key
#
# Until all four are set the site still takes bookings and sign-ups, and tells
# the visitor plainly that no confirmation email was sent.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# --- Admin ------------------------------------------------------------------
# Don't fill these in by hand — run `npm run setup` and it writes them for you,
# without your password ever appearing on screen.
#
#   ADMIN_USERNAME       the ID you type at /admin (defaults to "admin")
#   ADMIN_PASSWORD_HASH  a scrypt hash; the password itself is never stored
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional: keeps admin logins alive across server restarts. Any long random
# string. Leave blank and everyone is simply logged out when you restart.
ADMIN_SESSION_SECRET=

# Token for scripts and cron jobs hitting POST /api/rates directly.
# If left blank, a random one is generated and printed at startup.
ADMIN_TOKEN=

# --- Public address ---------------------------------------------------------
# Used in the daily reminder so the "enter the rate" link works from a phone.
# Set this to the real domain once the site is deployed.
PUBLIC_URL=http://localhost:4400

# --- Daily WhatsApp reminder (optional) -------------------------------------
# At 12:00 PM India time the server asks both owners for the day's rate.
#
# It ALWAYS emails Sunil (sunil_100521@yahoo.com) with a tap-to-send WhatsApp link for
# each owner — that works with no setup beyond the EmailJS keys above.
#
# To have the server message them directly instead, add WhatsApp Business Cloud
# API credentials. Note that Meta only allows free-form text inside a 24-hour
# window the customer opened; a business-initiated daily message needs a
# pre-approved template, so set WHATSAPP_TEMPLATE to its approved name.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# --- AI chatbot (optional) --------------------------------------------------
# Without a key the chatbot runs on a built-in intent engine that answers the
# common questions and hands off to WhatsApp. With a key it additionally uses
# Claude for free-form questions. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
